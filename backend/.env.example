# MediaVault Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=mediavault_super_secure_jwt_secret_key_2026_dev_prod
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / PGlite fallback)
# Set to 'pglite' to run embedded Postgres without local setup, or provide PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediavault
DB_CLIENT=pglite
PGLITE_DATA_DIR=./data/pglite_db

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
DEFAULT_USER_QUOTA_BYTES=10737418240 # 10 GB

